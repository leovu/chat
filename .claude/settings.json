{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/dart-format.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/flutter-analyze.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/flutter-test.sh"
          }
        ]
      }
    ]
  }
}
